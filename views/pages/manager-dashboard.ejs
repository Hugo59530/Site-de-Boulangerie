<%- include('../partials/header') %>
<main class="container page-shell">
  <div class="dashboard-header">
    <div>
      <p class="eyebrow">Espace gérant</p>
      <h1>Tableau de bord</h1>
    </div>
  </div>

  <section class="card">
    <h3>Messages clients</h3>
    <% if (!messages || messages.length === 0) { %>
      <p>Aucun message pour le moment.</p>
    <% } else { %>
      <% messages.forEach(message => { %>
        <article class="message-item">
          <div class="message-head">
            <strong><%= message.name %></strong>
            <span><%= new Date(message.created_at).toLocaleString('fr-FR') %></span>
          </div>
          <p><%= message.email || 'Pas d’email' %></p>
          <p><%= message.message %></p>
          <% if (message.manager_reply) { %>
            <div class="reply-box">
              <strong>Réponse :</strong>
              <p><%= message.manager_reply %></p>
              <small>Par <%= message.replied_by %> • <%= new Date(message.replied_at).toLocaleString('fr-FR') %></small>
            </div>
          <% } else { %>
            <form action="/messages/<%= message.id %>/reply" method="post" class="reply-form">
              <textarea name="reply" placeholder="Répondre au client..." required></textarea>
              <button type="submit" class="btn btn-primary">Envoyer la réponse</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    <% } %>
  </section>
</main>
<%- include('../partials/footer') %>
