        </figure>
        <figure class="carousel-slide">
          <img src="/images/Boulangerie.jpg" alt="Vue boulangerie" />
          <figcaption>Un lieu chaleureux et authentique</figcaption>
        </figure>
        <figure class="carousel-slide">
          <img src="/images/logo.svg" alt="Logo La Rhônelle" />
