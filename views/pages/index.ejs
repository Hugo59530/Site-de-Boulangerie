    <div class="carousel-dots" aria-label="Navigation du carrousel">
      <button type="button" class="dot active" aria-label="Aller à l'image 1"></button>
      <button type="button" class="dot" aria-label="Aller à l'image 2"></button>
      <button type="button" class="dot" aria-label="Aller à l'image 3"></button>
      <button type="button" class="dot" aria-label="Aller à l'image 4"></button>
      <button type="button" class="dot" aria-label="Aller à l'image 5"></button>
    </div>
  </section>

  <section class="container facebook-feed-section">
